{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasktree.dev/schema/v2/template.schema.json",
  "title": "TasktreeTemplate",
  "description": "A V2 template (kind: Template): a task record plus an optional tasktree definition, with {{variable}} substitution. Every variable used must be declared in parameters.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "task"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "tasktree.dev/v2" },
    "kind": { "const": "Template" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Name used by `tasktree new --template <name>`." },
        "description": { "type": "string" }
      }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/Parameter" }
    },
    "task": {
      "type": "object",
      "description": "Record fields; any string may contain {{variables}}. --jira/--handle/--status on `new` override these.",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "handle": { "type": "string" },
        "jira": { "type": "string" },
        "status": { "type": "string", "description": "incoming, next, active, blocked, done or dropped after rendering." },
        "labels": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "tasktree": {
      "type": "object",
      "description": "Optional tasktree definition created with the task (no checkout).",
      "additionalProperties": false,
      "properties": {
        "repos": { "type": "array", "items": { "$ref": "#/$defs/Repo" } },
        "symlinks": { "type": "array", "items": { "$ref": "#/$defs/Symlink" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/File" } },
        "bootstrap": { "type": "array", "items": { "$ref": "#/$defs/BootstrapStep" } }
      }
    }
  },
  "$defs": {
    "Parameter": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "Repo": {
      "type": "object",
      "required": ["repo"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "minLength": 1, "description": "Alias or clone URL." },
        "name": { "type": "string" },
        "branch": { "type": "string" },
        "from": { "type": "string" },
        "mode": { "type": "string", "description": "follow, work or pin after rendering (K2 derives it when absent)." }
      }
    },
    "File": {
      "type": "object",
      "required": ["path", "content"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "mode": { "type": "string", "description": "0644 or 0755 after rendering." }
      }
    },
    "Symlink": {
      "type": "object",
      "required": ["path", "target"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "BootstrapStep": {
      "type": "object",
      "required": ["name", "run"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "run": { "type": "string", "minLength": 1 },
        "workdir": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
